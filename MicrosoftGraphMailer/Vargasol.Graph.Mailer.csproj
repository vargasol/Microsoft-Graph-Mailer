<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace>$(MSBuildProjectName)</RootNamespace>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<SignAssembly>False</SignAssembly>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Company>Gabor Varga</Company>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/vargasol/Microsoft-Graph-Mailer</PackageProjectUrl>
		<Copyright>Varga IT Solutions</Copyright>
		<RepositoryUrl>https://github.com/vargasol/Microsoft-Graph-Mailer</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>e-mail,message,azuread,smtp</PackageTags>
		<Description>Packages gives some help to could send e-mail via Azure AD Tenant using modern authentication</Description>
		<Version>3.0.0</Version>
		<PackageReadmeFile>README.md</PackageReadmeFile>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
		<DebugType>none</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.14" />
		<PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.14" />
		<PackageReference Include="Microsoft.Identity.Client" Version="4.92.0" />
		<PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
		<None Include="README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
